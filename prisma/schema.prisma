model Subdistrict {
  DISTRICT_ID     Int     @id @default(autoincrement())
  DISTRICT_CODE   String  @db.VarChar(6)
  DISTRICT_NAME   String  @db.VarChar(150)
  AMPHUR_ID       Int
  PROVINCE_ID     Int
  GEO_ID          Int

  @@map("b_district")
}
model Province {
  PROVINCE_ID   Int     @id @default(autoincrement())
  PROVINCE_CODE String  @db.VarChar(2)
  PROVINCE_NAME String  @db.VarChar(150)
  GEO_ID        Int
}
model Amphur {
  AMPHUR_ID   Int     @id @default(autoincrement())
  AMPHUR_CODE String  @db.VarChar(4)
  AMPHUR_NAME String  @db.VarChar(150)
  GEO_ID      Int
  PROVINCE_ID Int
}
// =====================================================
// Hospital Master
// =====================================================
model Hospital {
  hos_id         Int     @id @default(autoincrement())
  code_hos9      String  @db.VarChar(20)
  code_hos5      String  @db.VarChar(20)
  hos_type       String  @db.VarChar(50)
  hos_name       String  @db.VarChar(100)
  hos_address    String  @db.VarChar(200)
  province_code  String  @db.VarChar(20)
  province_name  String  @db.VarChar(50)
  amphur_code    String  @db.VarChar(20)
  amphur_name    String  @db.VarChar(50)
  district_code  String  @db.VarChar(20)
  district_name  String  @db.VarChar(50)
  zipcode        String  @db.VarChar(10)
  district_id    String  @db.VarChar(20)

  @@map("b_hospital")
}
// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN       // ผู้ดูแลระบบ
  STAFF       // เจ้าหน้าที่บันทึก (รพ., รพ.สต.)
  EXECUTIVE   // ผู้บริหาร
  DOCTOR      // แพทย์ผู้ตรวจ
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
}

enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
}

enum PilgrimStatus {
  REGISTERED
  READY
  PENDING
  CANCELLED
}

enum HealthCheckStatus {
  SCHEDULED
  COMPLETED
  PENDING
  OVERDUE
}

enum VaccinationStatus {
  PENDING
  COMPLETED
  SCHEDULED
}

enum TrainingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
}

// =====================================================
// User Management
// =====================================================
model User {
  id           String     @id @default(uuid())
  username     String     @unique
  email        String     @unique
  password     String
  fullName     String
  role         UserRole   @default(STAFF)
  hospital     String?
  phoneNumber  String?
  status       UserStatus @default(ACTIVE)
  lastLogin    DateTime?
  refreshToken String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  address      String?    @db.VarChar(255)
  subdistrict  String?    @db.VarChar(100)
  district     String?    @db.VarChar(100)
  province     String?    @db.VarChar(100)
  workplace    String?    @db.VarChar(255)
  position     String?    @db.VarChar(100)
}

// Vaccination model removed: Pilgrim and VaccineType do not exist in DB

// =====================================================
// Training/Courses
// =====================================================
model Course {
  id                  String   @id @default(uuid())
  courseName          String
  courseNameEn        String?
  category            String
  description         String?  @db.Text
  duration            Int      // in hours
  instructor          String
  required            Boolean  @default(false)
  
  startDate           DateTime
  endDate             DateTime
  schedule            String
  location            String
  
  maxParticipants     Int
  currentParticipants Int      @default(0)
  
  status              String   @default("OPEN")
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  // trainings Training[] // removed: Training model does not exist

  @@index([startDate])
  @@index([status])
  @@map("courses")
}

